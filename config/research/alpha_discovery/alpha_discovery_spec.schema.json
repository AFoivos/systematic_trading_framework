{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "alpha_discovery_spec.schema.json",
  "title": "Standalone Alpha Discovery Specification",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "pipeline",
    "research_id",
    "status",
    "specification_hash",
    "approval",
    "scientific_contract",
    "data_eligibility",
    "historical_partition",
    "snapshot_reference",
    "historical_pseudo_oos_reference",
    "evidence_roles",
    "features",
    "horizons",
    "targets_planned",
    "conditional_analysis",
    "execution_measurement",
    "statistics",
    "multiple_testing",
    "promotion_gates",
    "artifacts",
    "runtime",
    "blockers"
  ],
  "properties": {
    "schema_version": {"const": 2},
    "pipeline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "stage"],
      "properties": {
        "kind": {"const": "alpha_discovery_v1"},
        "stage": {"const": "PRE_SIGNAL_RESEARCH"}
      }
    },
    "research_id": {"type": "string", "pattern": "^AR-[0-9]{4}$"},
    "status": {"enum": ["SPECIFICATION_ONLY", "APPROVED_TO_RUN"]},
    "specification_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "approved_to_run",
        "approved_by",
        "approved_at",
        "approved_specification_hash"
      ],
      "properties": {
        "approved_to_run": {"type": "boolean"},
        "approved_by": {"type": ["string", "null"], "minLength": 1},
        "approved_at": {"type": ["string", "null"], "minLength": 1},
        "approved_specification_hash": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "scientific_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role_assignment",
        "validation_contamination",
        "prospective_clock",
        "material_changes"
      ],
      "properties": {
        "role_assignment": {"const": "IMMUTABLE_PER_SNAPSHOT"},
        "validation_contamination": {
          "const": "MODIFICATION_AFTER_VIEW_REQUIRES_NEW_VALIDATION"
        },
        "prospective_clock": {"const": "MATERIAL_CHANGE_RESTARTS_CLOCK"},
        "material_changes": {
          "type": "array",
          "minItems": 8,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "enum": [
              "FEATURE_DEFINITIONS",
              "FEATURE_WINDOWS",
              "BINS",
              "HORIZONS",
              "COSTS",
              "HYPOTHESIS_CONDITIONS",
              "PROMOTION_GATES",
              "EXECUTION_SEMANTICS"
            ]
          }
        }
      }
    },
    "data_eligibility": {
      "const": {
        "canonical_bar_policy": "FULL_30_OF_30_OBSERVED_MINUTES",
        "observed_minute_count_column": "observed_minute_count",
        "required_observed_minutes": 30,
        "timestamp_gap_policy": "PRESERVE_TIMELINE_INVALIDATE_DEPENDENCY_WINDOWS",
        "feature_window_policy": "FULL_CONTIGUOUS_T_MINUS_W_THROUGH_T",
        "target_window_policy": "FULL_CONTIGUOUS_T_THROUGH_T_PLUS_H_PLUS_1",
        "partial_bar_repair": "FORBIDDEN",
        "gap_imputation": "FORBIDDEN"
      }
    },
    "historical_partition": {
      "const": {
        "parent_snapshot_id": "ETHUSD-30M-CANONICAL-V1",
        "parent_manifest_path": "data/research_snapshots/ETHUSD-30M-CANONICAL-V1/manifest.json",
        "parent_expected_sha256": "83d182c98ccbb225220eac02b1bae57917e3b2d2feee5929c53d57c8abaf4202",
        "cutoff_utc": "2025-07-01T00:00:00Z",
        "assignment_rule": "TIMESTAMP_LT_CUTOFF_DISCOVERY_ELSE_HISTORICAL_PSEUDO_OOS",
        "child_snapshot_write_mode": "IMMUTABLE_WRITE_ONCE"
      }
    },
    "snapshot_reference": {
      "allOf": [
        {"$ref": "#/$defs/childSnapshotReference"},
        {"properties": {"evidence_role": {"const": "DISCOVERY"}}}
      ]
    },
    "historical_pseudo_oos_reference": {
      "allOf": [
        {"$ref": "#/$defs/childSnapshotReference"},
        {"properties": {"evidence_role": {"const": "HISTORICAL_PSEUDO_OOS"}}}
      ]
    },
    "evidence_roles": {
      "type": "object",
      "additionalProperties": false,
      "required": ["DISCOVERY", "VALIDATION", "HISTORICAL_PSEUDO_OOS", "PROSPECTIVE_FINAL"],
      "properties": {
        "DISCOVERY": {"$ref": "#/$defs/roleContract"},
        "VALIDATION": {"$ref": "#/$defs/roleContract"},
        "HISTORICAL_PSEUDO_OOS": {"$ref": "#/$defs/roleContract"},
        "PROSPECTIVE_FINAL": {"$ref": "#/$defs/roleContract"}
      }
    },
    "features": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {"$ref": "#/$defs/featureContract"}
    },
    "horizons": {
      "type": "array",
      "prefixItems": [
        {"const": 1}, {"const": 2}, {"const": 4},
        {"const": 8}, {"const": 16}, {"const": 32}
      ],
      "items": false,
      "minItems": 6,
      "maxItems": 6
    },
    "targets_planned": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {"$ref": "#/$defs/targetContract"}
    },
    "conditional_analysis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bins",
        "freeze_bin_edges",
        "one_dimensional_states",
        "two_dimensional_interactions",
        "allow_3d"
      ],
      "properties": {
        "bins": {"const": "DISCOVERY_FITTED_QUINTILES"},
        "freeze_bin_edges": {"const": true},
        "one_dimensional_states": {"const": true},
        "two_dimensional_interactions": {
          "const": [["path_efficiency", "realized_volatility"]]
        },
        "allow_3d": {"const": false}
      }
    },
    "execution_measurement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state_available_at",
        "entry",
        "exit",
        "quote_source",
        "net_cost_scope",
        "additional_costs"
      ],
      "properties": {
        "state_available_at": {"const": "CLOSE_T"},
        "entry": {"const": "OPEN_T_PLUS_1"},
        "exit": {"const": "OPEN_T_PLUS_H_PLUS_1"},
        "quote_source": {"const": "ACTUAL_DUKASCOPY_BID_ASK"},
        "net_cost_scope": {"const": "OBSERVED_BID_ASK_SPREAD_ONLY"},
        "additional_costs": {
          "type": "object",
          "additionalProperties": false,
          "required": ["commission", "slippage", "swap"],
          "properties": {
            "commission": {"const": "NOT_INCLUDED_NO_FROZEN_ASSUMPTION"},
            "slippage": {"const": "NOT_INCLUDED_NO_FROZEN_ASSUMPTION"},
            "swap": {"const": "NOT_INCLUDED_NO_FROZEN_ASSUMPTION"}
          }
        }
      }
    },
    "statistics": {
      "const": {
        "inference_target": "EXECUTABLE_RETURN",
        "net_cost_scope": "OBSERVED_BID_ASK_SPREAD_ONLY",
        "minimum_observations": 200,
        "minimum_coverage_fraction": 0.5,
        "minimum_occupied_primary_blocks": 20,
        "hac": {
          "estimator": "CONDITIONAL_MEAN_RATIO",
          "kernel": "BARTLETT",
          "primary_lag_rule": "FIXED_BARS",
          "primary_lag_bars": 48,
          "sensitivity_lags_bars": [96, 192],
          "sensitivity_role": "DIAGNOSTIC_ONLY_NON_BINDING"
        },
        "block_bootstrap": {
          "method": "STRATIFIED_SEGMENTED_MOVING_BLOCK",
          "timeline": "FULL_UNCOMPRESSED_CANONICAL_ROWS",
          "strata": "FROZEN_CALENDAR_PERIODS",
          "gap_handling": "NO_BLOCK_CROSSES_GAP",
          "primary_block_length_bars": 48,
          "sensitivity_block_lengths_bars": [96, 192],
          "sensitivity_role": "DIAGNOSTIC_ONLY_NON_BINDING",
          "resamples": 2000,
          "confidence_level": 0.95,
          "minimum_valid_resample_fraction": 0.99,
          "seed": 7
        },
        "chronological_stability": {
          "partition": "FROZEN_CALENDAR_PERIODS",
          "periods": [
            {"name": "Y2020", "start_inclusive": "2020-01-01T00:00:00Z", "end_exclusive": "2021-01-01T00:00:00Z"},
            {"name": "Y2021", "start_inclusive": "2021-01-01T00:00:00Z", "end_exclusive": "2022-01-01T00:00:00Z"},
            {"name": "Y2022", "start_inclusive": "2022-01-01T00:00:00Z", "end_exclusive": "2023-01-01T00:00:00Z"},
            {"name": "Y2023", "start_inclusive": "2023-01-01T00:00:00Z", "end_exclusive": "2024-01-01T00:00:00Z"},
            {"name": "Y2024", "start_inclusive": "2024-01-01T00:00:00Z", "end_exclusive": "2025-01-01T00:00:00Z"},
            {"name": "Y2025H1", "start_inclusive": "2025-01-01T00:00:00Z", "end_exclusive": "2025-07-01T00:00:00Z"}
          ],
          "minimum_observations_per_period": 30,
          "required_periods": 6,
          "direction_rule": "SAME_NONZERO_SIGN_IN_ALL_REQUIRED_PERIODS"
        }
      }
    },
    "multiple_testing": {
      "const": {
        "family_definition": [
          "feature_family",
          "horizon",
          "target",
          "direction",
          "preregistered_interaction"
        ],
        "methods": ["BH", "BY"],
        "global_family_scope": "ALL_PREREGISTERED_EFFECTS",
        "global_family_size": 3792,
        "failed_hypothesis_p_value": 1.0,
        "retain_failed_in_denominator": true,
        "binding_method": "GLOBAL_BY",
        "primary_fdr_alpha": 0.05,
        "local_fdr_alpha": 0.05,
        "local_methods_role": "DIAGNOSTIC_ONLY_NON_BINDING",
        "status": "IMPLEMENTED_FROZEN_CONTRACT"
      }
    },
    "promotion_gates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "coverage",
        "effect_size",
        "temporal_stability",
        "execution_realism",
        "multiple_testing",
        "prospective_confirmation"
      ],
      "properties": {
        "coverage": {"$ref": "#/$defs/promotionGate"},
        "effect_size": {"$ref": "#/$defs/promotionGate"},
        "temporal_stability": {"$ref": "#/$defs/promotionGate"},
        "execution_realism": {"$ref": "#/$defs/promotionGate"},
        "multiple_testing": {"$ref": "#/$defs/promotionGate"},
        "prospective_confirmation": {"$ref": "#/$defs/promotionGate"}
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["output_root", "layout_version", "write_mode"],
      "properties": {
        "output_root": {"const": "logs/experiments/alpha_discovery"},
        "layout_version": {"const": 2},
        "write_mode": {"const": "IMMUTABLE_RUN_DIRECTORY"}
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["perform_alpha_calculation", "run_backtests", "access_prospective_final"],
      "properties": {
        "perform_alpha_calculation": {"type": "boolean"},
        "run_backtests": {"const": false},
        "access_prospective_final": {"const": false}
      }
    },
    "blockers": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    }
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "SPECIFICATION_ONLY"}}},
      "then": {
        "properties": {
          "approval": {
            "properties": {
              "approved_to_run": {"const": false},
              "approved_by": {"const": null},
              "approved_at": {"const": null},
              "approved_specification_hash": {"const": null}
            }
          },
          "runtime": {
            "properties": {
              "perform_alpha_calculation": {"const": false}
            }
          },
          "blockers": {"minItems": 1}
        }
      }
    },
    {
      "if": {"properties": {"status": {"const": "APPROVED_TO_RUN"}}},
      "then": {
        "properties": {
          "approval": {
            "properties": {
              "approved_to_run": {"const": true},
              "approved_by": {"type": "string", "minLength": 1},
              "approved_at": {
                "type": "string",
                "minLength": 1,
                "format": "date-time"
              },
              "approved_specification_hash": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          },
          "snapshot_reference": {
            "properties": {
              "manifest_path": {"type": "string", "minLength": 1},
              "source_classification": {"const": "VALIDATED_MARKET_DATA"},
              "legacy_classifications": {"maxItems": 0},
              "readiness": {"const": "ELIGIBLE"}
            }
          },
          "runtime": {
            "properties": {
              "perform_alpha_calculation": {"const": true}
            }
          },
          "blockers": {"maxItems": 0}
        }
      }
    }
  ],
  "$defs": {
    "childSnapshotReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "snapshot_id",
        "manifest_path",
        "source_path",
        "expected_sha256",
        "evidence_role",
        "source_classification",
        "legacy_classifications",
        "readiness",
        "parent_snapshot_id",
        "parent_sha256",
        "partition_start_inclusive",
        "partition_end_exclusive",
        "expected_row_count",
        "expected_first_timestamp",
        "expected_last_timestamp"
      ],
      "properties": {
        "snapshot_id": {"type": "string", "minLength": 1},
        "manifest_path": {"type": "string", "minLength": 1},
        "source_path": {"type": "string", "minLength": 1},
        "expected_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "evidence_role": {
          "enum": ["DISCOVERY", "HISTORICAL_PSEUDO_OOS"]
        },
        "source_classification": {"const": "VALIDATED_MARKET_DATA"},
        "legacy_classifications": {"const": []},
        "readiness": {"const": "ELIGIBLE"},
        "parent_snapshot_id": {"const": "ETHUSD-30M-CANONICAL-V1"},
        "parent_sha256": {
          "const": "83d182c98ccbb225220eac02b1bae57917e3b2d2feee5929c53d57c8abaf4202"
        },
        "partition_start_inclusive": {"type": "string", "minLength": 1},
        "partition_end_exclusive": {"type": "string", "minLength": 1},
        "expected_row_count": {"type": "integer", "minimum": 1},
        "expected_first_timestamp": {"type": "string", "minLength": 1},
        "expected_last_timestamp": {"type": "string", "minLength": 1}
      }
    },
    "availableAt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bar_offset", "event"],
      "properties": {
        "bar_offset": {"type": "integer", "minimum": 0},
        "event": {"enum": ["OPEN", "CLOSE"]}
      }
    },
    "roleContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["purpose", "access"],
      "properties": {
        "purpose": {"type": "string", "minLength": 1},
        "access": {"type": "string", "minLength": 1}
      }
    },
    "featureContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "windows", "available_at"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "windows": {"type": "array", "items": {"type": "integer", "minimum": 1}},
        "available_at": {"$ref": "#/$defs/availableAt"}
      }
    },
    "targetContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "status", "entry_available_at"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "status": {"const": "IMPLEMENTED_PHASE_3"},
        "entry_available_at": {"$ref": "#/$defs/availableAt"}
      }
    },
    "promotionGate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract", "status"],
      "properties": {
        "contract": {"type": "string", "minLength": 1},
        "status": {"const": "NOT_EVALUATED"}
      }
    }
  }
}
